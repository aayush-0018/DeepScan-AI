          "mode": "raw",
          "raw": "{\n  \"code\": \"app.post('/login', async (req, res) => {\\n  const { username, password } = req.body;\\n  const result = await client.query(\\n    `SELECT * FROM accounts WHERE username = '${username}' AND password = '${password}'`\\n  );\\n  res.json({ ok: result.rows.length > 0 });\\n});\\n\",\n  \"detector\": \"regex\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('regex detector used', () => pm.expect(pm.response.json().summary.detector).to.eql('regex'));"
            ]
          }
        }
      ]
    },
