# ---------- Backend ----------
# Directory holding the fine-tuned CodeBERT model (created by ml/train.py).
MODEL_DIR=artifacts/model
# auto | cpu | mps | cuda
DEVICE=auto
# Default detector when a request doesn't specify one: auto | ensemble | codebert | ast | regex
DEFAULT_DETECTOR=auto
# Minimum confidence for a finding to be reported (0-1).
CONFIDENCE_THRESHOLD=0.5
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=10
MAX_FILES=200

# ---------- Groq LLM explain mode ----------
# Placeholder: leave as-is to use the offline (template-based) explainer.
# Paste a real key from https://console.groq.com/keys to enable live LLM explanations.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_CONCURRENCY=4

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000
